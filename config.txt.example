# WiFi settings
ssid=yourssid
password=yourpassword

# Your location in lat/lon
lat=50.819767
lon=3.257726

# API key for openweathermap
openweathermap_key=yourapikey

# Refresh frequency and API cache
refresh_mins=60
cache_mins=10

# Display size can be 'small' or 'large'
display_size=small
# display_size=large

# Optional: Text renderer - 'basic' (8x8 built-in font, faster) or 'rich' (bitmap fonts, better quality)
# If not specified, defaults to 'basic'
# text_renderer=basic
# text_renderer=rich

# Optional: Display padding in pixels (top,right,bottom,left)
# If not specified, defaults to (0,2,0,0) i.e. small right margin
# padding=10,10,10,10

# Optional: Enable web server for remote admin
# If not specified, defaults to false
# server=true

# Optional: Port for web server to listen on
# If not specified, defaults to 80
# listen_port=8080
